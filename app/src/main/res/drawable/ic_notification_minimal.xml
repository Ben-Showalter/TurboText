<?xml version="1.0" encoding="utf-8"?>
<!-- Android renders notification small icons as a solid-color silhouette
     based on the icon's ALPHA channel, ignoring its actual RGB color —
     so making this "black" wouldn't make it invisible, it would still
     show as a filled white/tinted shape. What actually minimizes
     visibility is making the shape itself tiny, which is what this is:
     a single barely-there 2dp dot instead of a normal-sized icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="1"
        android:pathData="M12,11 a1,1 0 1,0 0.01,0 Z" />
</vector>
