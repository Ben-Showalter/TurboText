<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:padding="8dp"
        android:background="#222222" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:id="@+id/notificationSettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification Settings"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/signatureSettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signature Settings"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/addWordRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Words"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/themeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theme"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/micSourceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voice Input Mic: Phone"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/advancedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advanced"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:padding="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>
