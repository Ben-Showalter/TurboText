<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for a default SMS app -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- The notification-sounds folder (and the archive export folder) live
         at the root of shared storage, not inside this app's own sandboxed
         directory — on Android 11+ that needs "All files access" specifically,
         since scoped storage otherwise silently blocks writes to a path like
         this outside the app's own folder (WRITE_EXTERNAL_STORAGE above is
         capped at API 28 and does nothing on newer versions). Requested via
         NotificationSettingsActivity, not asked for at first launch. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Needed on API 31+ to route voice-to-text recording through a
         connected Bluetooth headset's mic (see BluetoothMicHelper). No-op
         on the API 29 target device, but declared for forward compat. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Without this, AudioManager silently denies setMode()/
         startBluetoothSco()/setBluetoothScoOn() — no exception, they just
         no-op — so Bluetooth-mic routing in BluetoothMicHelper never
         actually connects and every recording falls back to the phone mic. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- No touchscreen required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".TurboTextApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_square"
        android:theme="@style/Theme.TurboText">

        <!-- Conversation list: also the entry point when picked as default SMS handler -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TrashBinActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".SignatureSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AddWordActivity"
            android:exported="false" />

        <activity
            android:name=".MyWordsActivity"
            android:exported="false" />

        <activity
            android:name=".AppShortcutActivity"
            android:exported="false" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false" />

        <activity
            android:name=".TextEntryActivity"
            android:exported="false" />

        <activity
            android:name=".BroadcastListsActivity"
            android:exported="false" />

        <activity
            android:name=".BroadcastListDetailActivity"
            android:exported="false" />

        <activity
            android:name=".GroupMessagesActivity"
            android:exported="false" />

        <activity
            android:name=".AdvancedSettingsActivity"
            android:exported="false" />

        <receiver
            android:name=".SoundAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".SmsSentReceiver"
            android:exported="false" />

        <receiver
            android:name=".SmsDeliveredReceiver"
            android:exported="false" />

        <!-- Handles composing a new message from other apps (contacts, "Send SMS to" links, etc.) -->
        <activity
            android:name=".ComposeActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Thread view for a single conversation -->
        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Required: receives incoming SMS when this app is the default handler -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Required: receives incoming MMS when this app is the default handler -->
        <receiver
            android:name=".MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Receives the completion callback from MmsManager.downloadMultimediaMessage()
             (triggered via PendingIntent from MmsDeliverReceiver). This was
             missing entirely at first, which is exactly why the download
             request went out but nothing ever came back — Android has
             nowhere to deliver to without this declaration, even for a
             PendingIntent-only receiver like this one. -->
        <receiver
            android:name=".MmsDownloadReceiver"
            android:exported="true" />

        <!-- Required: lets the phone's "respond via message" (decline call with text) work -->
        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Lets the camera app hand a captured photo back to us as a content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MMS-sending library (com.klinkerapps:android-smsmms) plumbing.
             Note: we only use this library for MMS (photos) — plain SMS
             sending goes through our own SmsRepository — so we only need
             the receiver that marks an MMS as sent afterward. The library's
             SentReceiver/DeliveredReceiver classes are abstract and require
             a per-app subclass we don't need since we don't route SMS
             through this library. -->
        <receiver
            android:name="com.klinker.android.send_message.MmsSentReceiver"
            android:exported="false"
            android:taskAffinity="com.klinker.android.messaging.MMS_SENT" />

        <!-- Experimental — see KeyButtonAccessibilityService for why this
             is the only way to observe hardware key presses (like volume)
             from the background at all. Must be manually enabled by the
             user in Settings > Accessibility; nothing in the app can
             turn this on for them. -->
        <service
            android:name=".KeyButtonAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
