# Copy this file to keystore.properties (same folder) and fill in your
# own real values — keystore.properties itself is gitignored and never
# committed, since it holds real passwords.
#
# storeFile is the path to the .jks/.keystore file Android Studio's
# "Generate Signed Bundle / APK" wizard created for you — an absolute
# path is simplest, or a path relative to this file.

storeFile=/absolute/path/to/your/keystore.jks
storePassword=yourStorePasswordHere
keyAlias=yourKeyAliasHere
keyPassword=yourKeyPasswordHere
